NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Email — Gmail SMTP (via nodemailer). Sends as info@saudieventmanagement.com
# (a verified "Send mail as" alias inside SMTP_USER's Gmail account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=infosaudieventmanagement@gmail.com
SMTP_PASS=your_google_app_password_here

# SEM Copilot — AI provider (see src/lib/ai-provider.ts)
# AI_PROVIDER selects which SDK is used: anthropic | openai | gemini
# AI_MODEL is optional — overrides the built-in default model id for that provider
# Only the API key for the provider you select needs to be filled in
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
